# Job Application Tracking System — Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to git.

# ─── GMAIL ──────────────────────────────────────────────────────────────────
GMAIL_ADDRESS=your_gmail@gmail.com
GMAIL_CREDENTIALS_PATH=path/to/your/client_secret_xxx.apps.googleusercontent.com.json
GMAIL_TOKEN_PATH=token.json
GMAIL_LABEL=JobTracker
GMAIL_AUTO_MARK_READ=false

# ─── GEMINI AI ───────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# ─── TELEGRAM ────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ─── GOOGLE SHEETS ───────────────────────────────────────────────────────────
SHEETS_ENABLED=true
SHEETS_SPREADSHEET_NAME=Job Applications Tracker
# Leave SHEETS_SPREADSHEET_ID empty on first run — the system creates the sheet
# automatically and logs the ID. Fill it in after the first run to reuse it.
SHEETS_SPREADSHEET_ID=

# ─── APP PREFERENCES ─────────────────────────────────────────────────────────
POLL_INTERVAL_MINUTES=30
DEFAULT_FOLLOWUP_DAYS=7
# Comma-separated target roles — helps the AI classify emails more accurately
TARGET_ROLES=Python Backend Developer,SDE Intern,Python Developer
REGION=India
CITY=Bangalore
DATE_FORMAT=%d/%m/%Y
SALARY_FORMAT=INR_LPA

# ─── DATABASE ────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///jobtracker.db

# ─── LOGGING ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=logs
